// =====================================================================================
// Sankofa School Platform — data model
//
// Multi-tenant: every tenant-owned table carries `tenantId`, and queries reach the
// database through a tenant-scoped client that injects that filter, so it cannot be
// forgotten at a call site. See src/server/db/tenant-scope.ts.
//
// Conventions:
//   * UUIDv7 primary keys — time-ordered, so index inserts stay at the right edge, and
//     non-sequential in public, so one tenant cannot enumerate another's records.
//   * Human-facing references (STU-2026-000123) are a separate column, allocated by a
//     concurrency-safe counter, never the primary key.
//   * Money is Decimal(19,4) with an explicit currency. Never Float.
//   * Timestamps are UTC. Calendar-only values use @db.Date.
//   * Enumerations are Prisma enums; lifecycle is a state machine, never a set of booleans.
// =====================================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the application (Supabase's Supavisor, transaction mode).
  url       = env("DATABASE_URL")
  // Session-mode connection for migrations, which cannot run through a transaction pooler.
  // Not the db.<ref>.supabase.co host: that is IPv6-only and unreachable from CI.
  directUrl = env("DIRECT_URL")
}

// =====================================================================================
// Platform
// =====================================================================================

enum TenantStatus {
  PROVISIONING
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  CLOSED
}

enum OnboardingState {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

/// One subscribing school organisation. The unit of data isolation.
model Tenant {
  id          String       @id @default(uuid(7)) @db.Uuid
  /// Subdomain label. A routing hint for the UI only — never the authorization decision.
  slug        String       @unique
  legalName   String
  displayName String
  shortName   String?
  status      TenantStatus @default(PROVISIONING)

  // Localisation defaults. Ghana is the first optimized configuration, not the only
  // supported one — these are data, never assumptions baked into code.
  countryCode     String  @db.Char(2)
  defaultCurrency String  @db.Char(3)
  timezone        String  @default("UTC")
  locale          String  @default("en-GH")
  dateFormat      String  @default("dd/MM/yyyy")
  customDomain    String? @unique

  onboardingState OnboardingState @default(NOT_STARTED)
  activatedAt     DateTime?
  suspendedAt     DateTime?
  closedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships           Membership[]
  roles                 Role[]
  campuses              Campus[]
  academicYears         AcademicYear[]
  terms                 Term[]
  branding              Branding?
  auditLogs             AuditLog[]
  securityEvents        SecurityEvent[]
  referenceSequences    ReferenceSequence[]
  students              Student[]
  guardians             Guardian[]
  guardianRelationships GuardianRelationship[]
  enrolments            Enrolment[]

  classGroups ClassGroup[]

  attendanceRegisters AttendanceRegister[]
  attendanceEntries   AttendanceEntry[]

  feeItems              FeeItem[]
  feeSchedules          FeeSchedule[]
  feeScheduleLines      FeeScheduleLine[]
  invoices              Invoice[]
  invoiceLines          InvoiceLine[]
  creditNotes           CreditNote[]
  payments              Payment[]
  paymentAllocations    PaymentAllocation[]
  refunds               Refund[]
  /// §187: a child is not told the family is in arrears. Off by default, and a second
  /// gate behind FEES_VIEW so granting that permission by accident does not tell a
  /// fifteen-year-old what their parents owe.
  studentsSeeFeeBalance Boolean             @default(false)

  @@index([status])
  @@map("tenant")
}

/// Concurrency-safe numbering for human-facing references: STU-2026-000123, REC-2026-000932.
/// Allocation takes a row lock so two cashiers cannot mint the same receipt number.
model ReferenceSequence {
  tenantId  String   @db.Uuid
  scope     String
  periodKey String   @default("")
  prefix    String   @default("")
  padWidth  Int      @default(6)
  nextValue BigInt   @default(1)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, scope, periodKey])
  @@map("reference_sequence")
}

// =====================================================================================
// Identity and access
//
// Authorization is expressed as granular permissions, never as role-name comparisons
// scattered through the code. A role is a bundle a school can redefine; a permission code
// is a stable capability the code can reason about.
// =====================================================================================

enum UserStatus {
  PENDING_INVITE
  ACTIVE
  DISABLED
  LOCKED
  CLOSED
}

/// One row per human, platform-wide. A parent with children at two subscribing schools is
/// ONE user with TWO memberships.
model AppUser {
  id            String  @id @default(uuid(7)) @db.Uuid
  email         String  @unique
  emailVerified Boolean @default(false)

  /// bcrypt. Null until an invited user sets their password.
  passwordHash String?

  fullName      String
  preferredName String?
  phoneE164     String?
  avatarPath    String?
  locale        String?
  timezone      String?

  status      UserStatus @default(PENDING_INVITE)
  mfaEnrolled Boolean    @default(false)
  mfaRequired Boolean    @default(false)

  /// Any session issued before this instant is rejected, so a compromised account can be
  /// cut off without waiting for a token to expire.
  sessionsValidFrom DateTime  @default(now())
  lastLoginAt       DateTime?

  /// Single-use, hashed. Set when a school invites someone or a password reset is requested.
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  auditLogs      AuditLog[]
  securityEvents SecurityEvent[]

  @@index([status])
  @@map("app_user")
}

/// The global catalogue of granular capabilities. The only unit an access check consults.
model Permission {
  id               String  @id @default(uuid(7)) @db.Uuid
  /// MODULE_NOUN_VERB. Stable forever — a mistake is corrected by adding the right code
  /// and deprecating the wrong one, never by editing in place.
  code             String  @unique
  module           String
  description      String
  /// Must be assigned individually, never swept in by a "grant the whole module" convenience.
  isSensitive      Boolean @default(false)
  /// Touches a child's health, discipline, counselling record or whereabouts.
  isChildSensitive Boolean @default(false)

  rolePermissions RolePermission[]
  directGrants    MembershipPermissionGrant[]

  @@index([module])
  @@map("permission")
}

enum RoleScope {
  PLATFORM
  SCHOOL
}

/// A named bundle of permissions. `tenantId == null` marks a system template every tenant
/// may use; a tenant may also define its own.
model Role {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String?   @db.Uuid
  code         String
  name         String
  description  String?
  scope        RoleScope @default(SCHOOL)
  isSystem     Boolean   @default(false)
  isAssignable Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  memberEntries MembershipRole[]

  @@unique([tenantId, code])
  @@map("role")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ENDED
}

enum PrincipalType {
  STAFF
  TEACHER
  STUDENT
  GUARDIAN
  PLATFORM
  SUPPORT
}

/// User × tenant. The effective tenant of a request is the tenant of the verified
/// membership — never a subdomain, header or parameter.
model Membership {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @db.Uuid
  userId   String  @db.Uuid
  /// Optional campus restriction for multi-campus tenants. Null means the whole tenant.
  campusId String? @db.Uuid

  status        MembershipStatus @default(INVITED)
  principalType PrincipalType
  /// Set once the corresponding domain row exists (staff / student / guardian).
  principalId   String?          @db.Uuid
  displayTitle  String?

  startedOn    DateTime? @db.Date
  endedOn      DateTime? @db.Date
  invitedAt    DateTime?
  acceptedAt   DateTime?
  lastActiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      AppUser                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  campus    Campus?                     @relation(fields: [campusId], references: [id], onDelete: SetNull)
  roles     MembershipRole[]
  grants    MembershipPermissionGrant[]
  auditLogs AuditLog[]

  /// A person may be both a member of staff and a parent at the same school, and those are
  /// genuinely different hats.
  classGroupsTaught ClassGroup[]

  @@unique([id, tenantId])
  @@unique([tenantId, userId, principalType])
  @@index([userId, status])
  @@index([tenantId, status])
  @@index([tenantId, principalType, principalId])
  @@map("membership")
}

model MembershipRole {
  membershipId String   @db.Uuid
  roleId       String   @db.Uuid
  grantedAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_role")
}

enum GrantEffect {
  ALLOW
  DENY
}

/// Per-person overrides, so a single sensitive capability can be given to one individual
/// without minting a bespoke role — and can be explicitly taken away. DENY beats ALLOW.
model MembershipPermissionGrant {
  membershipId String      @db.Uuid
  permissionId String      @db.Uuid
  effect       GrantEffect
  reason       String
  grantedAt    DateTime    @default(now())
  grantedBy    String      @db.Uuid
  expiresAt    DateTime?

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([membershipId, permissionId])
  @@map("membership_permission_grant")
}

enum SecuritySeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

/// Append-only. Failed sign-ins, password resets, MFA changes, privileged grants.
/// A refused sign-in has no user and no tenant — and is exactly the row worth keeping.
model SecurityEvent {
  id            String           @id @default(uuid(7)) @db.Uuid
  userId        String?          @db.Uuid
  tenantId      String?          @db.Uuid
  eventType     String
  severity      SecuritySeverity @default(INFO)
  occurredAt    DateTime         @default(now())
  ipAddress     String?
  userAgent     String?
  detail        Json             @default("{}")
  correlationId String?

  user   AppUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("security_event")
}

// =====================================================================================
// Audit
// =====================================================================================

/// Append-only record of who did what, to which record, when, and why.
/// Written in the same transaction as the change it describes, so the two commit or roll
/// back together. An audit trail that can disagree with its data is not evidence.
model AuditLog {
  id                String  @id @default(uuid(7)) @db.Uuid
  tenantId          String? @db.Uuid
  actorUserId       String? @db.Uuid
  actorMembershipId String? @db.Uuid

  /// MODULE_NOUN_VERB, past tense: ACADEMIC_YEAR_ACTIVATED, GRADE_AMENDED.
  action       String
  resourceType String
  resourceId   String? @db.Uuid
  /// The human-facing reference where one exists, so an auditor can search for what they
  /// actually have in front of them rather than a uuid.
  resourceRef  String?

  occurredAt  DateTime @default(now())
  /// Required for high-risk actions. Six months later, "who closed it" is far less useful
  /// than "and why".
  reason      String?
  beforeValue Json?
  afterValue  Json?

  ipAddress     String?
  userAgent     String?
  correlationId String?

  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor      AppUser?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  membership Membership? @relation(fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_log")
}

// =====================================================================================
// School structure
//
// Nothing here encodes Ghana. An academic year is a named date range with ordered terms
// inside it — a Ghanaian three-term year, an English three-term year and a two-semester
// international calendar are the same shape, differing only in rows.
// =====================================================================================

enum CampusStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

model Campus {
  id       String       @id @default(uuid(7)) @db.Uuid
  tenantId String       @db.Uuid
  code     String
  name     String
  /// Exactly one per tenant. Single-campus schools get one and never think about it again.
  isMain   Boolean      @default(false)
  status   CampusStatus @default(ACTIVE)

  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  countryCode  String? @db.Char(2)
  phoneE164    String?
  email        String?
  /// A campus in another country keeps its own; otherwise it inherits the tenant's.
  timezone     String?

  openedOn DateTime? @db.Date
  closedOn DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  students    Student[]
  enrolments  Enrolment[]

  classGroups ClassGroup[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("campus")
}

/// One row per tenant. logoPath is a storage path, never a URL: the bucket is private and
/// access is granted by a short-lived signed URL at render time.
model Branding {
  tenantId String @id @db.Uuid

  motto         String?
  logoPath      String?
  logoUpdatedAt DateTime?
  /// Constrained to accessible usage rather than rejected — see src/lib/brand-color.ts.
  primaryColor  String?
  accentColor   String?

  reportCardHeader   String?
  receiptHeader      String?
  invoiceHeader      String?
  documentFooter     String?
  headSignatureName  String?
  headSignatureTitle String?
  website            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("branding")
}

/// PLANNED -> ACTIVE -> CLOSED. CLOSED is terminal: reopening would retroactively change
/// what an already-issued report card means.
enum CalendarStatus {
  PLANNED
  ACTIVE
  CLOSED
}

model AcademicYear {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @db.Uuid
  code      String
  name      String
  startsOn  DateTime       @db.Date
  endsOn    DateTime       @db.Date
  status    CalendarStatus @default(PLANNED)
  /// The year new work defaults to. At most one per tenant.
  isCurrent Boolean        @default(false)

  closedAt DateTime?
  closedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms      Term[]
  enrolments Enrolment[]

  classGroups ClassGroup[]

  feeSchedules FeeSchedule[]
  invoices     Invoice[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("academic_year")
}

model Term {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String         @db.Uuid
  academicYearId String         @db.Uuid
  /// Orders terms within their year; what reporting joins on. `name` is what a school
  /// calls it, which is how one tenant uses "First Term" and another "Semester 1".
  sequence       Int
  code           String
  name           String
  startsOn       DateTime       @db.Date
  endsOn         DateTime       @db.Date
  status         CalendarStatus @default(PLANNED)
  isCurrent      Boolean        @default(false)
  /// Drives the "results overdue" signal.
  reportsDueOn   DateTime?      @db.Date

  closedAt DateTime?
  closedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Cascade)
  enrolments   Enrolment[]

  attendanceRegisters AttendanceRegister[]

  feeSchedules FeeSchedule[]
  invoices     Invoice[]

  @@unique([id, tenantId])
  @@unique([academicYearId, sequence])
  @@unique([academicYearId, code])
  @@index([tenantId, status])
  @@map("term")
}

// =====================================================================================
// Students and guardians
//
// A student belongs to one school (tenant). A guardian may have children at multiple schools,
// which is why guardians are separate from students and linked through relationships.
// =====================================================================================

enum StudentStatus {
  PROSPECTIVE
  ENROLLED
  ACTIVE
  SUSPENDED
  WITHDRAWN
  GRADUATED
  DECEASED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model Student {
  id        String @id @default(uuid(7)) @db.Uuid
  tenantId  String @db.Uuid
  /// Human-facing reference: STU-2026-000123
  reference String
  campusId  String @db.Uuid

  /// Personal information
  firstName     String
  lastName      String
  preferredName String?
  dateOfBirth   DateTime @db.Date
  gender        Gender
  nationality   String?  @db.Char(2)
  /// Ghana-specific: Primary school leaving exam results
  beceRawScore  Int?
  beceAggregate Int?
  beceYear      Int?

  /// Contact information
  phoneE164    String?
  email        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?

  /// Medical and special needs
  bloodType    String?
  medicalNotes String?
  allergies    String?
  specialNeeds String?

  /// Academic information
  admissionDate   DateTime? @db.Date
  admissionNumber String?
  previousSchool  String?

  /// Status tracking
  status           StudentStatus @default(PROSPECTIVE)
  enrollmentDate   DateTime?     @db.Date
  withdrawalDate   DateTime?     @db.Date
  withdrawalReason String?
  graduationDate   DateTime?     @db.Date

  /// System fields
  photoPath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus        Campus                 @relation(fields: [campusId, tenantId], references: [id, tenantId], onDelete: Restrict)
  guardianships GuardianRelationship[]
  enrollments   Enrolment[]

  attendanceEntries AttendanceEntry[]

  invoices Invoice[]
  payments Payment[]

  @@unique([id, tenantId])
  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([campusId, status])
  @@index([lastName, firstName])
  @@map("student")
}

enum GuardianRelationshipType {
  FATHER
  MOTHER
  GRANDFATHER
  GRANDMOTHER
  UNCLE
  AUNT
  LEGAL_GUARDIAN
  SPONSOR
  OTHER
}

model Guardian {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  /// Personal information
  firstName     String
  lastName      String
  preferredName String?
  dateOfBirth   DateTime? @db.Date
  gender        Gender?
  nationality   String?   @db.Char(2)

  /// Contact information
  phoneE164    String
  phoneE1642   String? // Alternate phone
  email        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?

  /// Occupation and employment
  occupation String?
  employer   String?
  workPhone  String?

  /// Identification
  nationalId     String? // Ghana Card or other national ID
  nationalIdType String? // GHANA_CARD, PASSPORT, etc.

  /// System fields
  photoPath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  relationships GuardianRelationship[]
  payments      Payment[]

  @@unique([id, tenantId])
  @@index([tenantId, lastName, firstName])
  @@map("guardian")
}

model GuardianRelationship {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @db.Uuid
  studentId  String @db.Uuid
  guardianId String @db.Uuid

  relationshipType GuardianRelationshipType
  isPrimary        Boolean                  @default(false)
  isEmergency      Boolean                  @default(false)
  canPickUp        Boolean                  @default(true)

  /// Financial responsibility
  paysFees      Boolean @default(false)
  feePercentage Int? // Percentage of fees this guardian pays

  /// Revocation. §6 calls custody "the case the product most often gets wrong": a link is
  /// revoked with a recorded reason, never deleted, because who had access and when is
  /// itself the record a safeguarding review reads back.
  revokedAt             DateTime?
  revokedReason         String?
  revokedByMembershipId String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([studentId, guardianId])
  @@index([tenantId, studentId])
  @@index([tenantId, guardianId])
  @@map("guardian_relationship")
}

// =====================================================================================
// Enrolment
//
// Links students to academic years and terms. A student may be enrolled in multiple
// terms across years (e.g., continuing education). The enrolment carries the student's
// class assignment and academic standing for that term.
// =====================================================================================

enum EnrolmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  WITHDRAWN
  SUSPENDED
}

model Enrolment {
  id             String @id @default(uuid(7)) @db.Uuid
  tenantId       String @db.Uuid
  studentId      String @db.Uuid
  academicYearId String @db.Uuid
  termId         String @db.Uuid
  campusId       String @db.Uuid

  /// Class assignment
  classId    String? @db.Uuid
  gradeLevel String? // JHS1, JHS2, JHS3, SHS1, etc.
  section    String? // A, B, C, etc.

  /// Academic standing
  status         EnrolmentStatus @default(PENDING)
  enrolmentDate  DateTime        @db.Date
  completionDate DateTime?       @db.Date

  /// Academic performance
  gpa           Decimal? @db.Decimal(4, 2)
  classRank     Int?
  totalStudents Int?

  /// Attendance summary
  daysPresent Int?
  daysAbsent  Int?
  daysLate    Int?

  /// Fees and financials
  feesOwed Decimal? @db.Decimal(19, 4)
  feesPaid Decimal? @db.Decimal(19, 4)
  currency String   @default("GHS") @db.Char(3)

  /// Notes
  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Cascade)
  term         Term         @relation(fields: [termId, tenantId], references: [id, tenantId], onDelete: Cascade)
  campus       Campus       @relation(fields: [campusId, tenantId], references: [id, tenantId], onDelete: Restrict)
  classGroup   ClassGroup?  @relation(fields: [classId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([studentId, termId])
  @@index([tenantId, academicYearId, termId])
  @@index([tenantId, studentId])
  @@index([tenantId, classId])
  @@index([tenantId, status])
  @@map("enrolment")
}

/// A class as a group of children for one academic year — Basic 5 A, and who teaches it.
///
/// `enrolment.classId` already existed as a nullable uuid with nothing behind it, so a typo
/// or another school's id went in unnoticed. This gives it a table and a foreign key, and
/// the key carries `tenantId` so a reference cannot cross schools: a tenant policy checks the
/// row being written, not the rows it points at, and a foreign-key check is a system
/// operation RLS is not applied to at all.
model ClassGroup {
  id             String @id @default(uuid(7)) @db.Uuid
  tenantId       String @db.Uuid
  academicYearId String @db.Uuid
  campusId       String @db.Uuid

  /// B5A, and the name a parent would recognise.
  code      String
  name      String
  yearLevel Int?

  /// Not a permission. Two teachers hold identical permissions and only one of them is
  /// responsible for this class, which is what decides who may take its register.
  classTeacherMembershipId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Cascade)
  campus       Campus       @relation(fields: [campusId, tenantId], references: [id, tenantId], onDelete: Restrict)
  classTeacher Membership?  @relation(fields: [classTeacherMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  enrolments   Enrolment[]

  registers AttendanceRegister[]

  feeSchedules FeeSchedule[]

  @@unique([id, tenantId])
  @@unique([tenantId, academicYearId, code])
  @@index([tenantId, academicYearId])
  @@index([tenantId, classTeacherMembershipId])
  @@map("class_group")
}

enum RegisterStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// One class, one school day.
///
/// The register is evidence. It is read back by a statutory return, by a safeguarding review
/// and, when a child comes to harm, by somebody asking who knew they were not in school — so
/// the rules that matter about it live in the database rather than only in an action.
model AttendanceRegister {
  id           String @id @default(uuid(7)) @db.Uuid
  tenantId     String @db.Uuid
  classGroupId String @db.Uuid
  /// The term the session date falls in. Carried rather than derived so the roll for a day is
  /// one join, and so a register cannot outlive the term it was taken in.
  termId       String @db.Uuid

  /// The school day, in the SCHOOL's timezone. Not the server's — see src/lib/attendance.ts.
  sessionDate DateTime       @db.Date
  status      RegisterStatus @default(DRAFT)

  takenByMembershipId     String?   @db.Uuid
  submittedAt             DateTime?
  submittedByMembershipId String?   @db.Uuid
  lockedAt                DateTime?
  lockedByMembershipId    String?   @db.Uuid
  /// Why it was locked — a statutory return, an end-of-term close.
  lockedReason            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classGroup ClassGroup        @relation(fields: [classGroupId, tenantId], references: [id, tenantId], onDelete: Restrict)
  term       Term              @relation(fields: [termId, tenantId], references: [id, tenantId], onDelete: Restrict)
  entries    AttendanceEntry[]

  @@unique([id, tenantId])
  @@unique([classGroupId, sessionDate])
  @@index([tenantId, sessionDate])
  @@index([tenantId, status])
  @@map("attendance_register")
}

/// One child, one register.
///
/// A child with no entry is NOT a child recorded as away — it is a child nobody accounted for,
/// which is the state a register exists to make visible. That is why absence is a status here
/// and not the absence of a row.
model AttendanceEntry {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @db.Uuid
  registerId String @db.Uuid
  studentId  String @db.Uuid

  status      AttendanceStatus
  /// Minutes late, where the status is LATE.
  minutesLate Int?
  /// Required for EXCUSED — an excusal without a reason is indistinguishable from a guess.
  reason      String?

  markedByMembershipId    String?   @db.Uuid
  markedAt                DateTime  @default(now())
  /// Set when the mark was changed after the register was submitted. A correction to a record
  /// somebody has already relied on is a different act from filling one in.
  correctedAt             DateTime?
  correctedByMembershipId String?   @db.Uuid
  correctionReason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  register AttendanceRegister @relation(fields: [registerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  student  Student            @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([registerId, studentId])
  @@index([tenantId, studentId])
  @@map("attendance_entry")
}

model FeeItem {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  code        String
  name        String
  /// Shown on the invoice line when the school wants more than the name.
  description String?

  /// An optional item is offered but not automatically billed — a school bus place, a club.
  isOptional Boolean @default(false)
  /// Retired items stay, because past invoices reference them.
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scheduleLines FeeScheduleLine[]
  invoiceLines  InvoiceLine[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, isActive])
  @@map("fee_item")
}

/// A price list: what this class pays, this term.
///
/// Versioned by status rather than edited in place. Once invoices have been raised from a
/// schedule, changing its prices would silently disagree with every invoice already sent —
/// so an ACTIVE schedule is frozen and a new one supersedes it (I-6).
enum FeeScheduleStatus {
  DRAFT
  ACTIVE
  /// Superseded. Kept because invoices reference it.
  ARCHIVED
}

model FeeSchedule {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  academicYearId String  @db.Uuid
  termId         String  @db.Uuid
  /// Null means "every class in the year". A schedule naming a class overrides the general one.
  classGroupId   String? @db.Uuid

  name     String
  currency String            @db.Char(3)
  status   FeeScheduleStatus @default(DRAFT)

  /// I-6. The date from which this schedule is the one in force.
  effectiveFrom DateTime  @db.Date
  activatedAt   DateTime?
  archivedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Cascade)
  term         Term         @relation(fields: [termId, tenantId], references: [id, tenantId], onDelete: Cascade)
  classGroup   ClassGroup?  @relation(fields: [classGroupId, tenantId], references: [id, tenantId], onDelete: Restrict)

  lines    FeeScheduleLine[]
  invoices Invoice[]

  @@unique([id, tenantId])
  @@index([tenantId, termId, status])
  @@map("fee_schedule")
}

model FeeScheduleLine {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  feeScheduleId String @db.Uuid
  feeItemId     String @db.Uuid

  /// I-2: decimal, and the currency lives on the schedule this line belongs to.
  amount      Decimal @db.Decimal(19, 4)
  /// Included on every invoice raised from this schedule unless the item is optional.
  isMandatory Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeSchedule FeeSchedule @relation(fields: [feeScheduleId, tenantId], references: [id, tenantId], onDelete: Cascade)
  feeItem     FeeItem     @relation(fields: [feeItemId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([feeScheduleId, feeItemId])
  @@map("fee_schedule_line")
}

enum InvoiceStatus {
  /// Being prepared. Editable.
  DRAFT
  /// Sent to the family. Immutable from here (I-3) — correct by credit note.
  ISSUED
  /// Voided before anything was paid against it. Kept, never deleted.
  CANCELLED
}

/// What one child owes for one term.
model Invoice {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  /// Allocated from `reference_sequence` at issue, not at creation: a draft that is never
  /// issued must not consume a number out of the sequence an auditor reads as contiguous.
  invoiceNo String?

  studentId      String  @db.Uuid
  academicYearId String  @db.Uuid
  termId         String  @db.Uuid
  /// Provenance. The amounts live on the lines; this only says where they came from.
  feeScheduleId  String? @db.Uuid

  status   InvoiceStatus @default(DRAFT)
  currency String        @db.Char(3)

  issuedOn DateTime? @db.Date
  dueOn    DateTime? @db.Date

  /// Sum of the lines before discount.
  subtotal      Decimal @default(0) @db.Decimal(19, 4)
  /// Discounts applied while drafting. A reduction after issue is a credit note instead.
  discountTotal Decimal @default(0) @db.Decimal(19, 4)
  /// subtotal − discountTotal. Stored rather than derived so a reprint cannot drift, and
  /// checked against the lines by a deferred trigger at commit (the I-4 pattern).
  total         Decimal @default(0) @db.Decimal(19, 4)

  cancelledAt     DateTime?
  cancelledReason String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Restrict)
  term         Term         @relation(fields: [termId, tenantId], references: [id, tenantId], onDelete: Restrict)
  feeSchedule  FeeSchedule? @relation(fields: [feeScheduleId, tenantId], references: [id, tenantId], onDelete: Restrict)

  lines       InvoiceLine[]
  allocations PaymentAllocation[]
  creditNotes CreditNote[]

  @@unique([tenantId, invoiceNo])
  @@unique([id, tenantId])
  /// One live invoice per child per term. A second one is how a family gets billed twice.
  @@index([tenantId, studentId, termId])
  @@index([tenantId, status])
  @@map("invoice")
}

model InvoiceLine {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  invoiceId String @db.Uuid
  feeItemId String @db.Uuid

  /// Snapshotted from the fee item at issue. I-6 and §4.2 both: the invoice reproduces what it
  /// said at the time, and renaming a fee item next year does not rewrite last year's paper.
  description String

  quantity   Int     @default(1)
  unitAmount Decimal @db.Decimal(19, 4)
  /// The share of the invoice's discount that landed on this line — apportioned so the parts
  /// sum exactly to the whole. See `apportion` in src/lib/money.ts.
  discount   Decimal @default(0) @db.Decimal(19, 4)
  /// quantity × unitAmount − discount.
  lineTotal  Decimal @db.Decimal(19, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  feeItem FeeItem @relation(fields: [feeItemId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, invoiceId])
  @@map("invoice_line")
}

/// Reduces an issued invoice, because an issued invoice cannot be edited (I-3).
///
/// This is the fee analogue of a journal reversal: the original stays exactly as it was sent,
/// and the correction is a second document that references it. A bursar who "just fixes the
/// amount" leaves the family holding a piece of paper the system disagrees with.
model CreditNote {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  creditNoteNo String?
  invoiceId    String  @db.Uuid

  amount   Decimal @db.Decimal(19, 4)
  currency String  @db.Char(3)

  /// Mandatory, with a floor. §188: a waiver is a decision somebody has to answer for.
  reason   String
  issuedOn DateTime @db.Date

  issuedByMembershipId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, creditNoteNo])
  @@index([tenantId, invoiceId])
  @@map("credit_note")
}

enum PaymentMethod {
  CASH
  /// Dominant in Ghana. The reference is the transaction id the family can quote back.
  MOBILE_MONEY
  BANK_TRANSFER
  CHEQUE
  CARD
}

enum PaymentStatus {
  RECORDED
  /// Bounced cheque, reversed transfer. The original row is never edited (I-3).
  REVERSED
}

/// Money received. Deliberately NOT "a payment of an invoice".
///
/// A family hands over ₵500 against a ₵1,200 invoice, or against two children's invoices, or
/// before any invoice exists. Tying a payment to exactly one invoice makes all three of those
/// impossible, and every school does all three. So a payment is money, and
/// `PaymentAllocation` decides what it settles; whatever is left is credit on account.
model Payment {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  receiptNo String?

  /// Who the money is for. A payment always lands on a child's account.
  studentId       String  @db.Uuid
  /// Who handed it over, where that is recorded. Null for a bank transfer nobody can attribute.
  payerGuardianId String? @db.Uuid

  method    PaymentMethod
  /// The momo transaction id, cheque number or bank reference. Not a secret, and never a
  /// card number: §6 of AGENTS.md forbids full payment detail in any log or column.
  reference String?

  amount   Decimal @db.Decimal(19, 4)
  currency String  @db.Char(3)

  receivedOn DateTime      @db.Date
  status     PaymentStatus @default(RECORDED)

  reversedAt     DateTime?
  reversedReason String?

  receivedByMembershipId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student   @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  payer   Guardian? @relation(fields: [payerGuardianId, tenantId], references: [id, tenantId], onDelete: Restrict)

  allocations PaymentAllocation[]
  refunds     Refund[]

  @@unique([tenantId, receiptNo])
  @@unique([id, tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, receivedOn])
  @@map("payment")
}

/// How much of a payment settles which invoice. The join that makes partial payment work.
model PaymentAllocation {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  paymentId String @db.Uuid
  invoiceId String @db.Uuid

  amount Decimal @db.Decimal(19, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([tenantId, invoiceId])
  @@map("payment_allocation")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
}

/// Money going back out, under maker-checker.
///
/// The bursar holds PAYMENT_REFUND and the finance manager holds PAYMENT_REFUND_APPROVE —
/// two different people, which is spec 134 and is exactly what the BURSAR role's own
/// description says. The database refuses a self-approval outright rather than trusting the
/// screen to hide the button, because one person who can both request and approve a refund
/// can pay themselves.
///
/// NOTE: this records the decision. Actually moving the money is a treasury operation that
/// needs the ledger, which does not exist yet.
model Refund {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  paymentId String @db.Uuid

  amount   Decimal @db.Decimal(19, 4)
  currency String  @db.Char(3)
  reason   String

  status RefundStatus @default(REQUESTED)

  requestedByMembershipId String    @db.Uuid
  requestedAt             DateTime  @default(now())
  decidedByMembershipId   String?   @db.Uuid
  decidedAt               DateTime?
  decisionNote            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("refund")
}
