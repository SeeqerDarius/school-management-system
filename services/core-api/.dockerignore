# Keep the build context small and, more importantly, keep secrets out of it.
# Anything copied into a build context can end up in an image layer, and image layers are
# readable by anyone who can pull the image.

target/
*.log

# ---- Credentials: never, under any circumstances ----
.env
.env.*
*.pem
*.key
*.p12
*.jks
**/serviceAccount*.json
**/firebase-adminsdk*.json
secrets/

# ---- Developer noise ----
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ---- Not needed to build the service ----
# Tests run in CI against a real PostgreSQL, not during the image build.
src/test/
README.md
