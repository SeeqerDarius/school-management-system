# =====================================================================================
# Sankofa School Platform — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Every value here is a DUMMY. Nothing in this file is, or has ever been, a real credential.
#
# Each environment (development, test, staging, production) gets its OWN credentials and its
# own Firebase project. Sharing a credential across environments means a staging compromise
# is a production compromise, and it makes rotation impossible to reason about.
# =====================================================================================

# -------------------------------------------------------------------------------------
# Database
#
# TWO IDENTITIES, DELIBERATELY. This is not redundancy.
#
#   DB_APP_*      the runtime role. NOT the table owner, NO BYPASSRLS, NOT a superuser.
#                 Row Level Security applies to it. This is the whole basis of tenant
#                 isolation — see docs/adr/0003-tenant-isolation-strategy.md.
#   DB_MIGRATE_*  owns the schemas, holds BYPASSRLS, runs Flyway and the outbox poller.
#
# Pointing both at the same role either breaks migrations or — far worse — silently disables
# RLS for the application while every test still passes. Do not do it.
# -------------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/sankofa
DB_APP_USER=sankofa_app
DB_APP_PASSWORD=change-me-app
DB_MIGRATE_USER=sankofa_migrate
DB_MIGRATE_PASSWORD=change-me-migrate

# Role NAMES, substituted into migrations as Flyway placeholders. Change only if your
# cluster's naming convention differs; they must match the roles actually created by
# database/bootstrap/00_roles.sql.
DB_APP_ROLE=sankofa_app
DB_MIGRATE_ROLE=sankofa_migrate

DB_POOL_MAX=20
DB_POOL_MIN=2

# -------------------------------------------------------------------------------------
# Firebase
#
# FIREBASE_CREDENTIALS_PATH points at a service-account JSON file on disk, OUTSIDE the
# repository. Leave empty to use Application Default Credentials, which is preferred in
# any managed runtime.
#
# A service-account file grants full project access. It never goes in git, never goes in a
# container image layer, and never appears in a NEXT_PUBLIC_* variable.
# -------------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=sankofa-dev
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=sankofa-dev.firebasestorage.app

# Client-side Firebase config. These ARE public by design — they identify the project, they
# do not authorise anything. Access is decided by Firebase security rules and by the core API.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDUMMY-not-a-real-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sankofa-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sankofa-dev
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# -------------------------------------------------------------------------------------
# Web tier
# -------------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORE_API_BASE_URL=http://localhost:8080
# Signs the BFF session cookie. 32+ random bytes, different in every environment.
#   openssl rand -base64 48
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-48

# -------------------------------------------------------------------------------------
# Sessions
# -------------------------------------------------------------------------------------
SESSION_TTL=PT12H
# Bursar, accountant, payroll officer, school admin, platform admin. Shorter on purpose.
SESSION_PRIVILEGED_TTL=PT2H

# -------------------------------------------------------------------------------------
# Payment providers
#
# Provider-agnostic by design (§47). A school configures whichever it uses; the system
# never couples business logic to one gateway.
#
# The WEBHOOK_SECRET values verify inbound callbacks cryptographically. Without them, anyone
# who learns the endpoint URL can post "payment successful" and be issued a receipt.
# -------------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_dummy000000000000000000000000
PAYSTACK_WEBHOOK_SECRET=whsec_dummy00000000000000000000
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-dummy0000000000000000
FLUTTERWAVE_WEBHOOK_SECRET=whsec_dummy00000000000000000000

# -------------------------------------------------------------------------------------
# SMS and email
#
# SMS costs real money per message. Quotas and the bulk-send confirmation gate (§148) are
# enforced in the application, not by the provider.
# -------------------------------------------------------------------------------------
SMS_PROVIDER=hubtel
HUBTEL_CLIENT_ID=dummy-client-id
HUBTEL_CLIENT_SECRET=dummy-client-secret
HUBTEL_SENDER_ID=SANKOFA
ARKESEL_API_KEY=dummy-arkesel-key

EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=dummy@example.com
SMTP_PASSWORD=change-me-smtp
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Sankofa School Platform

# -------------------------------------------------------------------------------------
# Observability and runtime
# -------------------------------------------------------------------------------------
LOG_LEVEL=INFO
PORT=8080
# Interactive API docs. Off by default; turning it on in production is a decision, not a default.
SWAGGER_UI_ENABLED=false

OUTBOX_POLL_INTERVAL=PT5S
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=8
